# ============================================
# MULTI-VENDOR MARKETPLACE - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env.local and fill in your values
# Never commit .env.local to version control

# ============================================
# APPLICATION
# ============================================
# The base URL of your application (used in emails, redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node environment (development, production, test)
NODE_ENV=development

# ============================================
# SUPABASE
# ============================================
# Get these from your Supabase project settings
# Dashboard: https://supabase.com/dashboard/project/YOUR_PROJECT_ID/settings/api

# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase service role key (server-side only, NEVER expose in browser)
# Only needed for admin operations and server-side API routes
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ============================================
# EMAIL (RESEND)
# ============================================
# Get your API key from: https://resend.com/api-keys
# Used for transactional emails (order confirmations, notifications)

RESEND_API_KEY=re_your_resend_api_key_here

# Email sending domain (must be verified in Resend)
# Example: notifications@yourdomain.com
EMAIL_FROM_DOMAIN=yourdomain.com

# ============================================
# PAYMENT GATEWAY (Optional - for production)
# ============================================

# Stripe (Recommended for multi-vendor payouts)
# Get keys from: https://dashboard.stripe.com/apikeys
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# PayPal (Alternative)
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id
# PAYPAL_CLIENT_SECRET=your_paypal_secret

# Razorpay (For Indian market)
# NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=your_razorpay_secret

# ============================================
# ANALYTICS & MONITORING (Optional)
# ============================================

# Vercel Analytics (automatically enabled on Vercel)
# No configuration needed

# Sentry (Error tracking)
# NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
# SENTRY_AUTH_TOKEN=your_sentry_auth_token

# Google Analytics
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================
# FILE STORAGE (Using Supabase Storage by default)
# ============================================

# Alternative: AWS S3
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-bucket-name

# Alternative: Cloudinary
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# ============================================
# SEARCH (Optional - for advanced search)
# ============================================

# Algolia
# NEXT_PUBLIC_ALGOLIA_APP_ID=your_algolia_app_id
# NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=your_search_key
# ALGOLIA_ADMIN_KEY=your_admin_key

# Typesense
# TYPESENSE_API_KEY=your_typesense_api_key
# TYPESENSE_HOST=your-typesense-host
# TYPESENSE_PORT=443
# TYPESENSE_PROTOCOL=https

# ============================================
# SHIPPING (Optional - for production)
# ============================================

# EasyPost
# EASYPOST_API_KEY=your_easypost_api_key

# Shippo
# SHIPPO_API_KEY=your_shippo_api_key

# ============================================
# CACHING (Optional - Redis for production)
# ============================================

# Redis (Upstash recommended for serverless)
# REDIS_URL=redis://...
# REDIS_TOKEN=your_redis_token

# ============================================
# RATE LIMITING (Optional)
# ============================================

# Upstash Rate Limit
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=your_token

# ============================================
# SECURITY
# ============================================

# Session secret for server-side sessions (generate with: openssl rand -base64 32)
# SESSION_SECRET=your_random_32_char_secret

# CSRF token secret
# CSRF_SECRET=your_random_32_char_secret

# ============================================
# FEATURE FLAGS (Optional)
# ============================================

# Enable/disable features without code changes
# FEATURE_PRODUCT_VARIANTS=false
# FEATURE_LIVE_CHAT=false
# FEATURE_ADVANCED_ANALYTICS=false

# ============================================
# DEVELOPMENT ONLY
# ============================================

# Skip email sending in development (logs to console instead)
# SKIP_EMAIL=true

# Mock payment gateway in development
# MOCK_PAYMENTS=true

# ============================================
# NOTES
# ============================================
#
# 1. All NEXT_PUBLIC_* variables are exposed to the browser
# 2. Never commit this file with real values to version control
# 3. Keep production secrets secure and rotate them regularly
# 4. Use different keys for development, staging, and production
# 5. Vercel automatically injects environment variables from project settings
#