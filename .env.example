# App
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
NEXT_PUBLIC_APP_URL=https://your-domain.com
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# cPanel MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpaneluser_marketplace
DB_USER=cpaneluser_marketplace
DB_PASSWORD=replace-with-cpanel-mysql-password
DB_CONNECTION_LIMIT=10

# Optional email notifications
RESEND_API_KEY=
EMAIL_FROM_DOMAIN=notifications@your-domain.com

# Optional analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Softgen scripts should stay disabled on production cPanel unless needed.
NEXT_PUBLIC_ENABLE_SOFTGEN_SCRIPTS=false
NEXT_PUBLIC_ENABLE_ELEMENT_TAGGER=false
